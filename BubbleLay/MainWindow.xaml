<Window x:Class="BubbleDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Bubble Display" Height="700" Width="900"
        MinHeight="550" MinWidth="700"
        Background="#111111"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" Background="#111111" Padding="14">
            <StackPanel>

                <!-- Title -->
                <TextBlock Text="BUBBLE CONTROL"
                           FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                           Foreground="#555555"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Divider -->
                <Rectangle Height="1" Fill="#222222" Margin="0,0,0,10"/>

                <!-- Name -->
                <TextBlock Text="NAME"
                           FontFamily="Consolas" FontSize="8"
                           Foreground="#555555" Margin="0,0,0,4"/>

                <TextBox x:Name="txtName"
                         MaxLength="16"
                         FontFamily="Consolas" FontSize="9"
                         Background="#1A1A1A" Foreground="#CCCCCC"
                         BorderBrush="#333333" BorderThickness="1"
                         Padding="4,3" Margin="0,0,0,6"/>

                <CheckBox x:Name="chkShowName"
                          Content="SHOW NAME"
                          IsChecked="True"
                          FontFamily="Consolas" FontSize="8"
                          Foreground="#555555"
                          Margin="0,0,0,12"
                          Checked="ChkShowName_Changed"
                          Unchecked="ChkShowName_Changed"/>

                <!-- Divider -->
                <Rectangle Height="1" Fill="#222222" Margin="0,0,0,10"/>

                <!-- Message -->
                <TextBlock Text="MESSAGE"
                           FontFamily="Consolas" FontSize="8"
                           Foreground="#555555" Margin="0,0,0,4"/>

                <TextBox x:Name="txtMessage"
                         MaxLength="120"
                         FontFamily="Consolas" FontSize="9"
                         Background="#1A1A1A" Foreground="#CCCCCC"
                         BorderBrush="#333333" BorderThickness="1"
                         Padding="4,3" Margin="0,0,0,4"
                         TextChanged="TxtMessage_TextChanged"
                         KeyDown="TxtMessage_KeyDown"/>

                <!-- Char count -->
                <TextBlock x:Name="lblCharCount"
                           Text="0/120"
                           FontFamily="Consolas" FontSize="8"
                           Foreground="#3A3A3A"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,12"/>

                <!-- Divider -->
                <Rectangle Height="1" Fill="#222222" Margin="0,0,0,10"/>

                <!-- Speed -->
                <TextBlock Text="SPEED"
                           FontFamily="Consolas" FontSize="8"
                           Foreground="#555555" Margin="0,0,0,4"/>

                <Slider x:Name="sldSpeed"
                        Minimum="10" Maximum="120" Value="35"
                        TickFrequency="10"
                        Background="#111111"
                        Margin="0,0,0,12"/>

                <!-- Divider -->
                <Rectangle Height="1" Fill="#222222" Margin="0,0,0,10"/>

                <!-- Buttons -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnSend" Grid.Column="0"
                            Content="SEND"
                            FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                            Foreground="#BBBBBB" Background="#111111"
                            BorderBrush="#3A3A3A" BorderThickness="1"
                            Height="28" Cursor="Hand"
                            Click="BtnSend_Click"/>

                    <Button x:Name="btnClear" Grid.Column="2"
                            Content="CLEAR"
                            FontFamily="Consolas" FontSize="9"
                            Foreground="#646464" Background="#111111"
                            BorderBrush="#282828" BorderThickness="1"
                            Height="28" Cursor="Hand"
                            Click="BtnClear_Click"/>
                </Grid>

                <!-- Status -->
                <TextBlock x:Name="lblStatus"
                           Text=""
                           FontFamily="Consolas" FontSize="8"
                           Foreground="#3A3A3A"
                           HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      Background="#222222"
                      HorizontalAlignment="Stretch"/>

        <!-- RIGHT PANEL (WebView2) -->
        <Border Grid.Column="2" Background="#00FF00">
            <wv2:WebView2 x:Name="webView"/>
        </Border>

    </Grid>
</Window>
